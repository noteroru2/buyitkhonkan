---
const { items = [] } = Astro.props;
---

<nav class="breadcrumbs" aria-label="breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1
          ? <a href={item.href} data-track-event="breadcrumb_click" data-cta-location="breadcrumb">{item.name}</a>
          : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { margin-bottom: 18px; color: var(--ink-soft); font-size: .84rem; }
  ol { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0; padding: 0; list-style: none; }
  li { display: inline-flex; align-items: center; overflow-wrap: anywhere; }
  li + li::before { content: "›"; margin-right: 6px; color: #98a2b3; font-weight: 800; }
  a { color: #596579; font-weight: 700; }
  a:hover { color: var(--color-primary); text-decoration: none; }
  li:last-child span { color: var(--color-navy); font-weight: 750; }
</style>
