---
import { SITE } from '../data/site.js';
---

<a
  class="floating-line"
  href={SITE.lineHref}
  target="_blank"
  rel="noopener"
  aria-label={`ส่งรูปประเมินราคาผ่าน LINE ${SITE.lineId}`}
  data-track-event="line_click"
  data-cta-location="desktop_floating_line"
>
  <span class="floating-line__icon" aria-hidden="true">
    <svg viewBox="0 0 40 40" fill="none">
      <rect width="40" height="40" rx="12" fill="white" fill-opacity="0.18"/>
      <path d="M20 8C13.37 8 8 12.6 8 18.28c0 4.18 2.78 7.83 6.93 9.87-.3 1.12-1.1 4.07-1.26 4.7-.2.78.29 1.08.85.7.44-.29 5.83-3.86 7.43-4.97.34.05.68.07 1.05.07 6.63 0 12-4.6 12-10.27C35 12.6 26.63 8 20 8z" fill="white"/>
      <path d="M16 21v-5.5h1.3V20h2.5V21H16zm4.2 0v-5.5h1.3V21h-1.3zm2 0v-5.5h1.3l2.5 3.5v-3.5h1.3V21h-1.3l-2.5-3.5V21h-1.3zm-8.7-5.5h3.8V16.7h-1.25V21h-1.3v-4.3H13.5v-1.2z" fill="#06C755"/>
    </svg>
  </span>
  <span class="floating-line__copy">
    <strong>ส่งรูปประเมินราคา</strong>
    <small>LINE {SITE.lineId} · ฟรี</small>
  </span>
  <span class="floating-line__arrow" aria-hidden="true">→</span>
</a>

<style>
  .floating-line {
    position: fixed;
    right: clamp(18px, 2.2vw, 30px);
    bottom: clamp(18px, 2.2vw, 30px);
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 232px;
    padding: 10px 12px 10px 10px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 18px;
    background: #06c755;
    color: #fff;
    box-shadow: 0 18px 44px rgba(6, 199, 85, 0.28), 0 6px 18px rgba(15, 23, 42, 0.12);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
  }
  .floating-line::before {
    content: "";
    position: absolute;
    inset: -5px;
    z-index: -1;
    border-radius: 22px;
    background: rgba(6, 199, 85, 0.11);
  }
  .floating-line:hover {
    color: #fff;
    text-decoration: none;
    transform: translateY(-3px);
    filter: brightness(1.02);
    box-shadow: 0 22px 52px rgba(6, 199, 85, 0.34), 0 8px 22px rgba(15, 23, 42, 0.14);
  }
  .floating-line__icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
  }
  .floating-line__copy {
    display: grid;
    gap: 1px;
    line-height: 1.2;
  }
  .floating-line__copy strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 850;
  }
  .floating-line__copy small {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.9);
  }
  .floating-line__arrow {
    margin-left: auto;
    font-size: 1.2rem;
    font-weight: 800;
  }
  @media (max-width: 767px) {
    .floating-line { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-line { transition: none; }
  }
</style>
