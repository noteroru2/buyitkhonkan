---
import { SITE } from '../data/site.js';
const {
  itemLabel = 'สินค้าไอที',
  compact = false,
  location = 'money_page',
} = Astro.props;
---
<aside class:list={['money-conversion', { 'money-conversion--compact': compact }]} aria-label="ส่งข้อมูลเพื่อประเมินราคา">
  <div class="money-conversion__status"><span></span> ประเมินเบื้องต้นผ่าน LINE</div>
  <h2 class="money-conversion__title">ส่งรูป{itemLabel} เช็กราคาได้เลย</h2>
  <p>ไม่ต้องกรอกฟอร์มยาว ส่งข้อมูลหลัก 4 อย่างในแชทเดียว</p>
  <ol class="money-conversion__steps">
    <li><b>1</b><span><strong>รูปสินค้า</strong><small>หน้า–หลัง และตำหนิถ้ามี</small></span></li>
    <li><b>2</b><span><strong>รุ่น / สเปก</strong><small>ความจุ CPU GPU หรือเลขรุ่น</small></span></li>
    <li><b>3</b><span><strong>สภาพจริง</strong><small>แจ้งอาการเสียหรืออุปกรณ์ที่ขาด</small></span></li>
    <li><b>4</b><span><strong>พื้นที่ในขอนแก่น</strong><small>เพื่อเช็กรอบนัดรับที่เหมาะสม</small></span></li>
  </ol>
  <a href={SITE.lineHref} class="btn btn--line money-conversion__line" data-track-event="click_line" data-cta-location={location}>
    <span aria-hidden="true">LINE</span> ส่งรูปประเมินฟรี {SITE.lineId}
  </a>
  <p class="money-conversion__meta">{SITE.hours} · ราคาสุดท้ายยืนยันหลังตรวจสภาพจริง</p>
</aside>

<style>
  .money-conversion {
    position: relative;
    padding: 24px;
    border: 1px solid rgba(6, 199, 85, .22);
    border-radius: 24px;
    background: linear-gradient(180deg, #fff 0%, #f5fff9 100%);
    box-shadow: 0 24px 60px rgba(15, 23, 42, .12);
  }
  .money-conversion::before {
    content: "";
    position: absolute;
    inset: 0 24px auto;
    height: 4px;
    border-radius: 0 0 999px 999px;
    background: var(--color-line);
  }
  .money-conversion__status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #087a38;
    font-size: .82rem;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .money-conversion__status span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-line);
    box-shadow: 0 0 0 5px rgba(6, 199, 85, .12);
  }
  .money-conversion__title {
    margin: 0 0 8px;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }
  .money-conversion > p { color: var(--color-muted); margin: 0; }
  .money-conversion__steps {
    display: grid;
    gap: 10px;
    margin: 18px 0;
    padding: 0;
    list-style: none;
  }
  .money-conversion__steps li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 10px;
    align-items: center;
  }
  .money-conversion__steps b {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: #e9fff1;
    color: #07823b;
    font-size: .86rem;
  }
  .money-conversion__steps span { display: grid; line-height: 1.35; }
  .money-conversion__steps strong { color: var(--color-navy); font-size: .94rem; }
  .money-conversion__steps small { color: var(--color-muted); font-size: .78rem; margin-top: 2px; }
  .money-conversion__line { width: 100%; min-height: 54px; }
  .money-conversion__line span {
    display: inline-grid;
    place-items: center;
    min-width: 42px;
    height: 24px;
    padding-inline: 7px;
    border-radius: 999px;
    background: rgba(255,255,255,.2);
    font-size: .72rem;
  }
  .money-conversion__meta { margin-top: 10px !important; text-align: center; font-size: .76rem; line-height: 1.45; }
  .money-conversion--compact { padding: 20px; border-radius: 20px; box-shadow: var(--shadow-sm); }
  @media (max-width: 900px) {
    .money-conversion { max-width: 620px; }
  }
</style>
