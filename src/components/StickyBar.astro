---
import { SITE } from '../data/site.js';
const { variant = 'default' } = Astro.props;
const isArticle = variant === 'article';
---

<div class:list={['sticky-bar', { 'sticky-bar--article': isArticle }]} role="complementary" aria-label="ปุ่มติดต่อด่วน">
  <a
    href={SITE.lineHref}
    target="_blank"
    rel="noopener"
    class="sticky-bar__btn sticky-bar__btn--line"
    aria-label={`ส่งรูปประเมินราคาผ่าน LINE ${SITE.lineId}`}
    data-track-event="mobile_sticky_line_click"
    data-cta-location="mobile_sticky"
  >
    <svg class="sticky-bar__line-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <rect width="40" height="40" rx="11" fill="white" fill-opacity="0.2"/>
      <path d="M20 8C13.37 8 8 12.6 8 18.28c0 4.18 2.78 7.83 6.93 9.87-.3 1.12-1.1 4.07-1.26 4.7-.2.78.29 1.08.85.7.44-.29 5.83-3.86 7.43-4.97.34.05.68.07 1.05.07 6.63 0 12-4.6 12-10.27C35 12.6 26.63 8 20 8z" fill="white"/>
      <path d="M16 21v-5.5h1.3V20h2.5V21H16zm4.2 0v-5.5h1.3V21h-1.3zm2 0v-5.5h1.3l2.5 3.5v-3.5h1.3V21h-1.3l-2.5-3.5V21h-1.3zm-8.7-5.5h3.8V16.7h-1.25V21h-1.3v-4.3H13.5v-1.2z" fill="#06C755"/>
    </svg>
    <span class="sticky-bar__text">
      <strong>ส่งรูปประเมินฟรี</strong>
      <small>LINE {SITE.lineId}</small>
    </span>
    <span class="sticky-bar__arrow" aria-hidden="true">→</span>
  </a>

  <a
    href={SITE.phoneHref}
    class="sticky-bar__btn sticky-bar__btn--phone"
    aria-label={`โทร ${SITE.phone}`}
    data-track-event="mobile_sticky_phone_click"
    data-cta-location="mobile_sticky"
  >
    <svg class="sticky-bar__phone-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z" fill="currentColor"/>
    </svg>
    <span class="sticky-bar__text sticky-bar__text--phone">
      <strong>โทรหาเรา</strong>
      <small>{SITE.phone}</small>
    </span>
  </a>
</div>

<style>
  .sticky-bar { display: none; }

  @media (max-width: 767px) {
    .sticky-bar {
      display: grid;
      grid-template-columns: minmax(0, 1.42fr) minmax(118px, .72fr);
      gap: 8px;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      padding: 8px 10px calc(8px + env(safe-area-inset-bottom, 0px));
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid rgba(226, 232, 240, .9);
      box-shadow: 0 -12px 34px rgba(15, 23, 42, 0.12);
      backdrop-filter: blur(14px);
    }
    .sticky-bar__btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-width: 0;
      min-height: 58px;
      padding: 8px 11px;
      border-radius: 15px;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform 120ms ease, filter 120ms ease;
    }
    .sticky-bar__btn:hover { text-decoration: none; }
    .sticky-bar__btn:active { transform: scale(.985); filter: brightness(.96); }
    .sticky-bar__btn--line {
      background: linear-gradient(135deg, #06c755 0%, #04b34d 100%);
      color: #fff;
      box-shadow: 0 8px 20px rgba(6, 199, 85, .23);
    }
    .sticky-bar__btn--phone {
      background: #f5f7fb;
      color: var(--color-navy);
      border: 1px solid var(--color-border);
    }
    .sticky-bar__line-icon { width: 36px; height: 36px; flex: 0 0 36px; }
    .sticky-bar__phone-icon { width: 22px; height: 22px; flex: 0 0 22px; color: var(--color-primary); }
    .sticky-bar__text { display: grid; min-width: 0; gap: 1px; line-height: 1.16; text-align: left; }
    .sticky-bar__text strong { font-family: var(--font-display); font-size: .89rem; font-weight: 850; white-space: nowrap; }
    .sticky-bar__text small { font-size: .7rem; color: rgba(255,255,255,.88); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sticky-bar__text--phone small { color: var(--color-muted); }
    .sticky-bar__arrow { margin-left: auto; font-weight: 900; }
    .sticky-bar--article .sticky-bar__btn { min-height: 54px; }
  }

  @media (max-width: 390px) {
    .sticky-bar { grid-template-columns: minmax(0, 1.25fr) minmax(104px, .68fr); gap: 6px; padding-inline: 7px; }
    .sticky-bar__btn { gap: 6px; padding-inline: 8px; }
    .sticky-bar__line-icon { width: 31px; height: 31px; flex-basis: 31px; }
    .sticky-bar__phone-icon { width: 20px; height: 20px; flex-basis: 20px; }
    .sticky-bar__text strong { font-size: .8rem; }
    .sticky-bar__text small { font-size: .64rem; }
    .sticky-bar__arrow { display: none; }
  }

  @media (max-width: 340px) {
    .sticky-bar__text--phone small { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-bar__btn { transition: none; }
  }
</style>
