---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, CATEGORIES } from '../data/categories.js';
import { BRAND_PAGES } from '../data/brandPages.js';
import { MODEL_PAGES } from '../data/modelPages.js';
import { CONDITION_PAGES } from '../data/conditionPages.js';
import { LOCAL_PAGES, LOCAL_NAP } from '../data/localPages.js';
import ProductCategoryImage from '../components/media/ProductCategoryImage.astro';
import { PRODUCT_IMAGES } from '../data/productImages';
import { CATEGORY_ARTICLES } from '../data/indexRecoveryLinks.js';
import ArchitectureSkeleton from '../components/ArchitectureSkeleton.astro';
import ReleasedModelPage from '../components/ReleasedModelPage.astro';
import ReleasedConditionPage from '../components/ReleasedConditionPage.astro';
import ReleasedB2BPage from '../components/ReleasedB2BPage.astro';
import ReleasedDistrictPage from '../components/ReleasedDistrictPage.astro';
import ReleasedPriceHub from '../components/ReleasedPriceHub.astro';
import ReleasedAuthorityHub from '../components/ReleasedAuthorityHub.astro';
import MoneyConversionCard from '../components/MoneyConversionCard.astro';
import MoneyPageNav from '../components/MoneyPageNav.astro';
import TrustProofSystem from '../components/TrustProofSystem.astro';
import DiscoveryHub from '../components/DiscoveryHub.astro';
import { ARCHITECTURE_PAGES } from '../data/architectureRegistry.js';
import { getCategoryDiscovery, getDetailDiscovery } from '../data/discoveryLinks.js';
import { CORE_MONEY_CONTENT } from '../data/coreMoneyContent.js';
import { getHighIntentModelContent } from '../data/highIntentModelContent.js';
import { getHighIntentConditionContent } from '../data/highIntentConditionContent.js';
import { getHighIntentB2BContent } from '../data/highIntentB2BContent.js';
import { getHighIntentDistrictContent } from '../data/highIntentDistrictContent.js';

export function getStaticPaths() {
  return [
    ...CATEGORIES.map((c) => ({ params: { slug: c.path || c.slug }, props: { cat: c, kind: 'category' } })),
    ...BRAND_PAGES.map((brand) => ({ params: { slug: brand.path }, props: { brand, kind: 'brand' } })),
    ...MODEL_PAGES.map((model) => ({ params: { slug: model.path }, props: { model, kind: 'model' } })),
    ...CONDITION_PAGES.map((condition) => ({ params: { slug: condition.path }, props: { condition, kind: 'condition' } })),
    ...LOCAL_PAGES.map((localPage) => ({ params: { slug: localPage.path }, props: { localPage, kind: 'local' } })),
    ...ARCHITECTURE_PAGES
      .filter((page) => page.lifecycle === 'INDEX' && page.type !== 'guide' && page.path.split('/').filter(Boolean).length === 1)
      .map((architecturePage) => ({
        params: { slug: architecturePage.path.replace(/^\/+|\/+$/g, '') },
        props: { architecturePage, kind: 'architecture' },
      })),
  ];
}

const { cat, brand, model, condition, localPage, architecturePage, kind = 'category' } = Astro.props;
const releasedModelContent = architecturePage?.type === 'model' && architecturePage.lifecycle === 'INDEX'
  ? getHighIntentModelContent(architecturePage)
  : null;
const releasedConditionContent = architecturePage?.type === 'condition' && architecturePage.lifecycle === 'INDEX'
  ? getHighIntentConditionContent(architecturePage)
  : null;
const releasedB2BContent = architecturePage?.lifecycle === 'INDEX' && (architecturePage.type === 'b2b' || architecturePage.id === 'hub-b2b')
  ? getHighIntentB2BContent(architecturePage)
  : null;
const releasedDistrictContent = architecturePage?.type === 'local' && architecturePage.lifecycle === 'INDEX'
  ? getHighIntentDistrictContent(architecturePage)
  : null;
const releasedPriceHub = architecturePage?.id === 'hub-price' && architecturePage.lifecycle === 'INDEX' ? architecturePage : null;
const releasedAuthorityHub = architecturePage?.lifecycle === 'INDEX' && ['hub-products', 'hub-brands-models'].includes(architecturePage.id) ? architecturePage : null;
const catContent = cat ? { ...cat, ...(CORE_MONEY_CONTENT[cat.slug] || {}) } : null;
const sec = cat ? CATEGORIES.find((c) => c.slug === cat.secondary) : null;
const categoryArticle = cat ? CATEGORY_ARTICLES[cat.slug] : null;
const siteUrl = Astro.site?.href?.replace(/\/$/, '') || '';
const detail = brand || model || condition || localPage;
const pageTitle = architecturePage?.title || cat?.title || detail?.title;
const pageDesc = architecturePage?.description || catContent?.description || cat?.desc || detail?.desc;
const detailPrimary = model ? CATEGORIES.find((c) => c.slug === model.primaryCategory) : null;
const detailCategories = (brand?.categories || condition?.applies || localPage?.primary || [])
  .map((slug) => CATEGORIES.find((c) => c.slug === slug))
  .filter(Boolean);

const categoryPath = cat ? `/${cat.path || cat.slug}/` : '';
const productImage = cat ? PRODUCT_IMAGES[cat.slug] : null;
const primaryCategory = detailPrimary || detailCategories[0] || null;
const visibleBreadcrumbItems = architecturePage
  ? []
  : cat
  ? [{ name: 'หน้าแรก', href: '/' }, { name: 'สินค้าที่รับซื้อ', href: '/สินค้าที่รับซื้อ/' }, { name: `${cat.kw} ขอนแก่น`, href: categoryPath }]
  : localPage
    ? [{ name: 'หน้าแรก', href: '/' }, { name: 'พื้นที่ให้บริการ', href: '/พื้นที่ให้บริการ/' }, { name: localPage.area, href: Astro.url.pathname }]
    : condition
      ? [{ name: 'หน้าแรก', href: '/' }, { name: 'สภาพสินค้าที่ขายได้', href: '/สภาพสินค้าที่ขายได้/' }, { name: condition.name || condition.condition, href: Astro.url.pathname }]
    : [{ name: 'หน้าแรก', href: '/' }, { name: 'สินค้าที่รับซื้อ', href: '/สินค้าที่รับซื้อ/' }, ...(primaryCategory ? [{ name: primaryCategory.name, href: `/${primaryCategory.path || primaryCategory.slug}/` }] : []), { name: brand?.brand || model?.name || condition?.name || detail.h1, href: Astro.url.pathname }];

const breadcrumb = cat ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${siteUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'สินค้าที่รับซื้อ',
      item: `${siteUrl}/สินค้าที่รับซื้อ/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${cat.kw} ขอนแก่น`,
      item: `${siteUrl}/${cat.path || cat.slug}/`,
    },
  ],
} : null;

const detailBreadcrumb = detail ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: visibleBreadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name,
    item: new URL(item.href, Astro.site).href,
  })),
} : null;

const serviceLd = architecturePage ? null : {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: cat ? `${cat.kw} ขอนแก่น` : detail.h1,
  description: pageDesc,
  url: `${siteUrl}${Astro.url.pathname}`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: `จังหวัด${SITE.region}`,
  },
  serviceType: 'รับซื้อสินค้าไอทีมือสอง',
};

const faqLd = cat ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: catContent.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const detailFaqLd = localPage?.faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localPage.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;

const releasedCategory = releasedModelContent
  ? CATEGORIES.find((item) => item.slug === releasedModelContent.categorySlug)
  : null;
const releasedBrand = releasedModelContent?.brandSlug
  ? BRAND_PAGES.find((item) => item.slug === releasedModelContent.brandSlug)
  : null;
const releasedBreadcrumbItems = releasedModelContent ? [
  { name: 'หน้าแรก', href: '/' },
  ...(releasedCategory ? [{ name: releasedCategory.name, href: `/${releasedCategory.path || releasedCategory.slug}/` }] : []),
  ...(releasedBrand ? [{ name: releasedBrand.brand, href: `/${releasedBrand.path}/` }] : []),
  { name: architecturePage.label, href: architecturePage.path },
] : [];
const releasedBreadcrumbLd = releasedModelContent ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: releasedBreadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.href, Astro.site).href,
  })),
} : null;
const releasedServiceLd = releasedModelContent ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: architecturePage.h1,
  description: architecturePage.description,
  url: `${siteUrl}${architecturePage.path}`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: `จังหวัด${SITE.region}` },
  serviceType: `รับซื้อ ${architecturePage.label} มือสอง`,
} : null;
const releasedFaqLd = releasedModelContent ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: releasedModelContent.faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;
const releasedConditionCategory = releasedConditionContent
  ? CATEGORIES.find((item) => item.slug === releasedConditionContent.categorySlug)
  : null;
const releasedConditionBreadcrumbItems = releasedConditionContent ? [
  { name: 'หน้าแรก', href: '/' },
  { name: 'สภาพสินค้าที่ขายได้', href: '/สภาพสินค้าที่ขายได้/' },
  ...(releasedConditionCategory ? [{ name: releasedConditionCategory.name, href: `/${releasedConditionCategory.path || releasedConditionCategory.slug}/` }] : []),
  { name: architecturePage.label, href: architecturePage.path },
] : [];
const releasedConditionBreadcrumbLd = releasedConditionContent ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: releasedConditionBreadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.href, Astro.site).href,
  })),
} : null;
const releasedConditionServiceLd = releasedConditionContent ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: architecturePage.h1,
  description: architecturePage.description,
  url: `${siteUrl}${architecturePage.path}`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: `จังหวัด${SITE.region}` },
  serviceType: `รับซื้อ ${architecturePage.label} มือสองตามสภาพ`,
} : null;
const releasedConditionFaqLd = releasedConditionContent ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: releasedConditionContent.faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;
const releasedB2BBreadcrumbItems = releasedB2BContent ? [
  { name: 'หน้าแรก', href: '/' },
  { name: 'รับซื้อยกล็อต', href: '/รับเหมาอุปกรณ์ไอที-ขอนแก่น/' },
  ...(architecturePage.id === 'hub-b2b' ? [] : [{ name: 'งานบริษัทและองค์กร', href: '/รับซื้อยกล็อต-บริษัท/' }]),
  { name: architecturePage.label, href: architecturePage.path },
] : [];
const releasedB2BBreadcrumbLd = releasedB2BContent ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: releasedB2BBreadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.href, Astro.site).href,
  })),
} : null;
const releasedB2BServiceLd = releasedB2BContent ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: architecturePage.h1,
  description: architecturePage.description,
  url: `${siteUrl}${architecturePage.path}`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: `จังหวัด${SITE.region}` },
  serviceType: 'รับซื้ออุปกรณ์ไอทียกล็อตสำหรับบริษัทและองค์กร',
} : null;
const releasedB2BFaqLd = releasedB2BContent ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: releasedB2BContent.faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;
const releasedDistrictBreadcrumbItems = releasedDistrictContent ? [
  { name: 'หน้าแรก', href: '/' },
  { name: 'พื้นที่ให้บริการ', href: '/พื้นที่ให้บริการ/' },
  { name: releasedDistrictContent.area, href: architecturePage.path },
] : [];
const releasedDistrictBreadcrumbLd = releasedDistrictContent ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: releasedDistrictBreadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.href, Astro.site).href,
  })),
} : null;
const releasedDistrictServiceLd = releasedDistrictContent ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: architecturePage.h1,
  description: architecturePage.description,
  url: `${siteUrl}${architecturePage.path}`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: `อำเภอ${releasedDistrictContent.area} จังหวัด${SITE.region}` },
  serviceType: 'บริการนัดรับซื้อสินค้าไอทีมือสองตามพื้นที่',
} : null;
const releasedDistrictFaqLd = releasedDistrictContent ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: releasedDistrictContent.faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;
const releasedPriceBreadcrumbLd = releasedPriceHub ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'บทความ', item: `${siteUrl}/บทความ/` },
    { '@type': 'ListItem', position: 3, name: releasedPriceHub.h1, item: `${siteUrl}${releasedPriceHub.path}` },
  ],
} : null;
const releasedPriceCollectionLd = releasedPriceHub ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: releasedPriceHub.h1,
  description: releasedPriceHub.description,
  url: `${siteUrl}${releasedPriceHub.path}`,
  isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website` },
} : null;
const releasedAuthorityBreadcrumbItems = releasedAuthorityHub
  ? releasedAuthorityHub.id === 'hub-products'
    ? [
        { name: 'หน้าแรก', href: '/' },
        { name: releasedAuthorityHub.h1, href: releasedAuthorityHub.path },
      ]
    : [
        { name: 'หน้าแรก', href: '/' },
        { name: 'สินค้าที่รับซื้อ', href: '/สินค้าที่รับซื้อ/' },
        { name: releasedAuthorityHub.h1, href: releasedAuthorityHub.path },
      ]
  : [];
const releasedAuthorityBreadcrumbLd = releasedAuthorityHub ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: releasedAuthorityBreadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.href, Astro.site).href,
  })),
} : null;
const releasedAuthorityCollectionLd = releasedAuthorityHub ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: releasedAuthorityHub.h1,
  description: releasedAuthorityHub.description,
  url: `${siteUrl}${releasedAuthorityHub.path}`,
  isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website` },
  about: releasedAuthorityHub.id === 'hub-products'
    ? { '@type': 'Thing', name: 'สินค้าไอทีมือสองที่รับซื้อในจังหวัดขอนแก่น' }
    : { '@type': 'Thing', name: 'ยี่ห้อ รุ่น และซีรีส์สินค้าไอทีมือสอง' },
} : null;
const jsonLd = releasedAuthorityHub
  ? [releasedAuthorityBreadcrumbLd, releasedAuthorityCollectionLd].filter(Boolean)
  : releasedPriceHub
  ? [releasedPriceBreadcrumbLd, releasedPriceCollectionLd].filter(Boolean)
  : releasedModelContent
  ? [releasedBreadcrumbLd, releasedServiceLd, releasedFaqLd].filter(Boolean)
  : releasedConditionContent
    ? [releasedConditionBreadcrumbLd, releasedConditionServiceLd, releasedConditionFaqLd].filter(Boolean)
    : releasedB2BContent
      ? [releasedB2BBreadcrumbLd, releasedB2BServiceLd, releasedB2BFaqLd].filter(Boolean)
      : releasedDistrictContent
        ? [releasedDistrictBreadcrumbLd, releasedDistrictServiceLd, releasedDistrictFaqLd].filter(Boolean)
        : architecturePage
        ? []
        : cat
          ? [breadcrumb, serviceLd, faqLd].filter(Boolean)
          : [detailBreadcrumb, serviceLd, detailFaqLd].filter(Boolean);
const architectureRendererReady = !architecturePage || Boolean(
  releasedAuthorityHub || releasedPriceHub || releasedModelContent || releasedConditionContent || releasedB2BContent || releasedDistrictContent
);
if (architecturePage?.lifecycle === 'INDEX' && !architectureRendererReady) {
  throw new Error(`INDEX architecture page is missing released content/renderer: ${architecturePage.path}`);
}
const robots = architecturePage?.lifecycle === 'HOLD_NOINDEX' ? 'noindex,follow' : undefined;
const detailItemLabel = brand?.brand || (model ? model.h1.replace(/^รับซื้อ\s*/, '').replace(/\s*ขอนแก่น.*$/, '') : null) || condition?.condition || (localPage ? `สินค้าไอทีใน${localPage.area}` : 'สินค้าไอที');
const discoveryGroups = architecturePage
  ? []
  : cat
    ? getCategoryDiscovery(cat)
    : getDetailDiscovery({ brand, model, condition, localPage });
---

<Base title={pageTitle} description={pageDesc} jsonLd={jsonLd} robots={robots}>
  {releasedAuthorityHub ? (
    <ReleasedAuthorityHub page={architecturePage} />
  ) : releasedPriceHub ? (
    <ReleasedPriceHub page={architecturePage} />
  ) : releasedModelContent ? (
    <ReleasedModelPage page={architecturePage} content={releasedModelContent} />
  ) : releasedConditionContent ? (
    <ReleasedConditionPage page={architecturePage} content={releasedConditionContent} />
  ) : releasedB2BContent ? (
    <ReleasedB2BPage page={architecturePage} content={releasedB2BContent} />
  ) : releasedDistrictContent ? (
    <ReleasedDistrictPage page={architecturePage} content={releasedDistrictContent} />
  ) : architecturePage ? (
    <ArchitectureSkeleton page={architecturePage} />
  ) : cat ? (
    <main id="main-content" class="article">
    <section class="cat-hero money-hero">
      <div class="container">
        <Breadcrumbs items={visibleBreadcrumbItems} />
        <div class="money-hero__grid">
          <div class="money-hero__content">
            <p class="cat-hero__icon" aria-hidden="true">{cat.icon}</p>
            <p class="money-hero__eyebrow">ประเมินตามรุ่น · สภาพ · ราคาตลาดจริง</p>
            <h1>{cat.h1}</h1>
            {catContent.intro.map((p) => <p class="lede">{p}</p>)}
            <p class="lede lede--soft">{SITE.serviceModel}</p>
            <div class="money-hero__trust" aria-label="จุดเด่นบริการ">
              <span>✓ ประเมินก่อนนัด</span><span>✓ ไม่ผูกมัด</span><span>✓ จ่ายหลังตรวจสภาพ</span>
            </div>
            {productImage && <ProductCategoryImage image={productImage} slotId={`category-intro-${cat.slug}`} class="cat-hero__product" />}
            <div class="cta-row">
              <a href={SITE.lineHref} class="btn btn--line" data-track-event="click_line" data-cta-location="money_hero">ส่งรูปประเมินฟรี LINE {SITE.lineId}</a>
              <a href={SITE.phoneHref} class="btn btn--ghost" data-track-event="click_phone" data-cta-location="money_hero">โทร {SITE.phone}</a>
            </div>
          </div>
          <MoneyConversionCard itemLabel={cat.name} location="money_hero_card" />
        </div>
      </div>
    </section>

    <Ticker />
    <div class="money-nav-wrap">
      <MoneyPageNav items={[
        { href: '#category_trust_proof', label: 'ตรวจสอบก่อนขาย' },
        { href: '#discover', label: 'สำรวจรุ่น/สภาพ/พื้นที่' },
        { href: '#accepted', label: 'รุ่นและสภาพที่รับ' },
        ...(catContent.sellerChecklist?.length ? [{ href: '#prepare', label: 'เตรียมข้อมูล' }] : []),
        { href: '#price', label: 'ปัจจัยและราคา' },
        { href: '#steps', label: 'ขั้นตอนขาย' },
        { href: '#area', label: 'พื้นที่นัดรับ' },
      ]} />
    </div>

    <TrustProofSystem variant="money" itemLabel={cat.name} location="category_trust_proof" />

    <div class="container article__body money-content">
      <h2>ก่อนขาย{cat.name}ในขอนแก่น ควรรู้อะไรบ้าง</h2>
      {catContent.why.map((p) => <p>{p}</p>)}
      <p>
        นอกจากหมวดนี้ เรายัง<a href="/">รับซื้อสินค้าไอที ขอนแก่น</a>ครบหลายประเภทในที่เดียว
        มีของหลายหมวดปนกันก็ส่งประเมินพร้อมกันได้ในแชทเดียว
      </p>

      <h2 id="accepted">{cat.kw}อะไรบ้าง — รุ่น ยี่ห้อ และสภาพที่ประเมินได้</h2>
      {catContent.sub.map((s) => (
        <>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </>
      ))}

      {catContent.sellerChecklist?.length && (
        <section id="prepare" class="seller-prep" aria-labelledby={`prepare-${cat.slug}`}>
          <h2 id={`prepare-${cat.slug}`}>ส่งข้อมูลอะไรเพื่อให้ประเมิน{cat.name}ได้ตรงขึ้น</h2>
          <p>ไม่ต้องกรอกแบบฟอร์มยาว ๆ เริ่มจากข้อมูลที่ตรวจสอบได้ก่อน หากมีจุดใดดูไม่เป็นให้ส่งรูปมาแทน ทีมงานจะถามเพิ่มเฉพาะข้อมูลที่จำเป็น</p>
          <div class="seller-prep__grid">
            {catContent.sellerChecklist.map((item, index) => (
              <div class="seller-prep__item"><span aria-hidden="true">{index + 1}</span><p>{item}</p></div>
            ))}
          </div>
        </section>
      )}

      <h2 id="price">ราคา{cat.kw}มือสอง ประเมินจากอะไรบ้าง</h2>
      <p>{catContent.price}</p>
      {cat.priceRows && (
        <div class="price-box" aria-label={`ตารางราคา${cat.kw}มือสอง`}>
          <div class="price-box__head">
            <h3>ตารางราคา{cat.name}มือสองโดยประมาณ</h3>
            <p>ช่วงราคาอ้างอิงในชุดข้อมูลเว็บไซต์ ณ {cat.updatedAt} — กรุณาเช็กราคาปัจจุบันอีกครั้งก่อนตัดสินใจ</p>
          </div>
          <div class="price-table-wrap">
            <table class="price-table">
              <thead>
                <tr>
                  <th>กลุ่มรุ่น / สินค้า</th>
                  <th>ช่วงราคาประเมิน</th>
                  <th>หมายเหตุ</th>
                </tr>
              </thead>
              <tbody>
                {cat.priceRows.map((row) => (
                  <tr>
                    <td>{row.item}</td>
                    <td>{row.range}</td>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
      <p>
        ราคาที่แจ้งเป็นราคาอ้างอิงเบื้องต้น ไม่ใช่ราคาสุดท้ายจนกว่าจะตรวจสภาพจริง
        และอาจเปลี่ยนตามรุ่นย่อย สภาพ อุปกรณ์ ตำหนิ และราคาตลาด ณ วันที่ตรวจสอบ
      </p>
      <p>
        แหล่งอ้างอิงเพิ่มเติม: <a href={catContent.ext.url} target="_blank" rel="noopener">{catContent.ext.text}</a>
      </p>

      {catContent.resolveBeforeSale?.length && (
        <aside class="resolve-box" aria-label={`สิ่งที่ควรจัดการก่อนส่งมอบ${cat.name}`}>
          <h3>ก่อนส่งมอบ ควรจัดการเรื่องเหล่านี้ให้เรียบร้อย</h3>
          <ul>{catContent.resolveBeforeSale.map((item) => <li>{item}</li>)}</ul>
          <p>หากไม่แน่ใจว่าสถานะของเครื่องพร้อมขายหรือไม่ ส่งภาพหน้าสถานะมาถามก่อนได้ โดยไม่ต้องส่งรหัสผ่านหรือข้อมูลลับของบัญชี</p>
        </aside>
      )}

      <div class="money-inline-cta"><strong>อยากรู้ราคาก่อนอ่านต่อ?</strong><span>ส่งรูปและรุ่นเข้า LINE ได้ทันที ทีมงานประเมินจากข้อมูลจริงของเครื่อง</span><a href={SITE.lineHref} class="btn btn--line" data-track-event="click_line" data-cta-location="money_mid_content">ส่งรูปเช็กราคา {SITE.lineId}</a></div>
      <h2 id="steps">ขั้นตอนขาย{cat.name}กับ WINNER IT</h2>
      <p>
        ขั้นแรก ถ่ายรูป{cat.name}ของคุณให้เห็นสภาพรอบตัวเครื่องและจุดตำหนิถ้ามี
        ส่งเข้าไลน์ {SITE.lineId} พร้อมแจ้งรุ่นและอุปกรณ์ที่มีครบ
        ขั้นที่สอง หลังได้รับข้อมูลครบ ทีมงานจะแจ้งราคาเบื้องต้นตามลำดับคิวในเวลาทำการ ({SITE.hours})
        ตัวเลขนี้ไม่ผูกมัด ไม่พอใจก็ปฏิเสธได้ทันที
        ขั้นสุดท้าย นัดจุดรับที่สะดวกหรือให้ทีมงานไปรับถึงที่
        ตรวจสภาพต่อหน้าแล้วชำระเงินสดหรือโอนหน้างาน
        พื้นที่และเวลานัดรับขึ้นอยู่กับตารางงานของทีมงานในแต่ละวัน
      </p>
      {categoryArticle && (
        <p>
          อ่านข้อมูลที่เกี่ยวข้องก่อนส่งประเมินได้ที่
          <a href={categoryArticle.href}>{categoryArticle.text}</a>
        </p>
      )}

      {cat.exampleScenario && (
        <>
          <h2>ตัวอย่างสถานการณ์ที่สามารถส่งประเมินได้</h2>
          <div class="case-study">
            <h3>{cat.exampleScenario.title}</h3>
            <p>{cat.exampleScenario.detail}</p>
            <p><strong>หมายเหตุ:</strong> นี่เป็นตัวอย่างขั้นตอน ไม่ใช่บันทึกธุรกรรมของลูกค้ารายใด</p>
          </div>
        </>
      )}

      <h2 id="area">พื้นที่ให้บริการ{cat.kw}ในจังหวัดขอนแก่น</h2>
      <p>
        พื้นที่ที่มีข้อมูลบริการหลัก ได้แก่ {SITE.areas.map((a) => `อ.${a}`).join(' ')}
        ส่วนพื้นที่อื่นในจังหวัดสามารถส่งพิกัดหรือชื่ออำเภอมาสอบถามรอบได้ก่อน การนัดรับขึ้นอยู่กับระยะทาง คิวงาน และความเหมาะสมของรายการในวันนั้น
      </p>
      <p>
        มีของหมวดอื่นอยากขายพร้อมกัน ดูรายละเอียด<a href={`/${sec.path || sec.slug}/`}>{sec.kw} ขอนแก่น</a>
        หรือดูภาพรวมบริการ<a href="/">รับซื้อสินค้าไอทีในขอนแก่น</a>ได้จากหน้าหลัก
      </p>

      <DiscoveryHub
        id="discover"
        groups={discoveryGroups}
        title={`สำรวจข้อมูลต่อจาก${cat.name}`}
        intro="เลือกดูรุ่นหรือแบรนด์ที่ตรงกว่า เช็กสภาพที่มีผลต่อราคา ดูพื้นที่นัดรับ หรืออ่านคู่มือก่อนขาย โดยทุกลิงก์พาไปยังหน้าที่เปิดใช้งานจริง"
      />

      <h4 class="h4-block">คำถามที่พบบ่อยเกี่ยวกับการขาย{cat.name}</h4>
      <div class="faq">
        {catContent.faq.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

    </div>

    <section class="section cta">
      <div class="container cta__in">
        <h4 class="cta__head">พร้อมขายแล้ว? ส่งรูปประเมิน{cat.name}ได้เลย</h4>
        <p>ถ่ายรูป ส่งไลน์ รอราคาเบื้องต้น — {SITE.hours} · {SITE.brandLine}</p>
        <div class="cta__btns">
          <a href={SITE.lineHref} class="btn btn--line" data-track-event="click_line">ทัก LINE {SITE.lineId}</a>
          <a href={SITE.phoneHref} class="btn btn--volt" data-track-event="click_phone">โทร {SITE.phone}</a>
        </div>
      </div>
    </section>
    </main>
  ) : (
    <main id="main-content" class="article detail-page">
      <section class="cat-hero money-hero">
        <div class="container">
          <Breadcrumbs items={visibleBreadcrumbItems} />
          <div class="money-hero__grid">
            <div class="money-hero__content">
              <p class="eyebrow">{kind === 'brand' ? 'Brand / Demand Page' : kind === 'model' ? model.group : kind === 'condition' ? 'Condition Page' : 'พื้นที่ให้บริการ'}</p>
              <h1>{detail.h1}</h1>
              <p class="lede">{brand?.intro || model?.intent || condition?.priceImpact || localPage?.note}</p>
              <p class="lede lede--soft">{SITE.serviceModel}</p>
              <div class="money-hero__trust" aria-label="จุดเด่นบริการ">
                <span>✓ ส่งรูปก่อนนัด</span><span>✓ ประเมินตามสภาพ</span><span>✓ นัดรับในขอนแก่น</span>
              </div>
              <div class="cta-row">
                <a href={SITE.lineHref} class="btn btn--line" data-track-event="click_line" data-cta-location="detail_hero">ส่งรูปประเมินฟรี LINE {SITE.lineId}</a>
                <a href={SITE.phoneHref} class="btn btn--ghost" data-track-event="click_phone" data-cta-location="detail_hero">โทร {SITE.phone}</a>
              </div>
            </div>
            <MoneyConversionCard itemLabel={detailItemLabel} location="detail_hero_card" />
          </div>
        </div>
      </section>
      <div class="money-nav-wrap">
        <MoneyPageNav items={[
          { href: '#detail_trust_proof', label: 'ตรวจสอบก่อนขาย' },
          { href: '#details', label: 'ข้อมูลสำคัญ' },
          ...(discoveryGroups.length ? [{ href: '#discover', label: 'สำรวจหน้าที่เกี่ยวข้อง' }] : []),
          { href: '#steps', label: 'ส่งประเมินอย่างไร' },
        ]} />
      </div>

      <TrustProofSystem variant="money" itemLabel={detailItemLabel} location="detail_trust_proof" />

      <div class="container article__body money-content">
        {brand && (
          <>
            <h2 id="details">ดีมานด์ของ {brand.brand} ในตลาดมือสองขอนแก่น</h2>
            <p>{brand.demand}</p>
            <h2>ซีรีส์ของ {brand.brand} ที่รับประเมินบ่อย</h2>
            <div class="chip-grid">{brand.acceptedModels.map((item) => <span>{item}</span>)}</div>
            <h2>สัญญาณที่ทำให้ราคา {brand.brand} สูงหรือต่ำ</h2>
            <ul>{brand.priceSignals.map((item) => <li>{item}</li>)}</ul>
            <h2>ข้อมูลเฉพาะที่ควรส่งมาก่อนประเมิน</h2>
            <ul>{brand.inspection.map((item) => <li>{item}</li>)}</ul>
            <div class="case-study"><strong>หมายเหตุเฉพาะแบรนด์:</strong> {brand.caution}</div>
          </>
        )}

        {model && (
          <>
            <h2 id="details">ข้อมูลเฉพาะของหน้านี้</h2>
            <ul>{model.specificData.map((item) => <li>{item}</li>)}</ul>
            <h2>ปัจจัยที่มีผลกับราคา</h2>
            <div class="chip-grid">{model.priceSignals.map((item) => <span>{item}</span>)}</div>
            <h2>ควรเตรียมอะไรส่งมาก่อนประเมิน</h2>
            <ul>{model.prepare.map((item) => <li>{item}</li>)}</ul>
          </>
        )}

        {condition && (
          <>
            <h2 id="details">หมวดสินค้าที่มักเจอสภาพนี้</h2>
            <p>{condition.priceImpact}</p>
            <h2>ควรถ่ายรูปอะไรส่งให้ทีมประเมิน</h2>
            <ul>
              <li>ภาพรวมรอบตัวเครื่องและอุปกรณ์ที่มี</li>
              <li>ภาพตำหนิระยะใกล้ให้เห็นชัด ไม่ใช้ฟิลเตอร์</li>
              <li>หน้าข้อมูลรุ่น ความจุ serial หรือสเปกเครื่อง</li>
              <li>วิดีโอสั้นถ้าอาการต้องเห็นตอนเปิดเครื่องหรือใช้งาน</li>
            </ul>
          </>
        )}

        {localPage && (
          <>
            <h2 id="details">รับซื้อสินค้าไอทีในโซน{localPage.area}อะไรบ้าง</h2>
            <p>
              {localPage.note}
              สินค้าที่มี demand ในพื้นที่นี้ ได้แก่ {localPage.demand.join(' · ')}
              หากอยู่ใกล้เคียงสามารถส่งพิกัดคร่าว ๆ ทาง LINE เพื่อจัดรอบได้
            </p>
            <div class="local-specific">
              <section>
                <h3>รูปแบบการนัดรับเฉพาะพื้นที่</h3>
                <p>{localPage.meetingStyle}</p>
              </section>
              <section>
                <h3>ช่วงให้บริการโดยไม่รับประกันเกินจริง</h3>
                <p>{localPage.serviceWindow}</p>
              </section>
            </div>
            <h2>จุดนัดที่ใช้จริงในโซน{localPage.area}</h2>
            <ul>{localPage.landmarks.map((item) => <li>{item}</li>)}</ul>
            {/* 
            <div class="local-photo">
              <div class="local-photo__mark" aria-hidden="true">แนวทางรูปจริง</div>
              <div>
                <h3>{localPage.photo.alt}</h3>
                <p>{localPage.photo.brief}</p>
              </div>
            </div>
            */}
            <h2>ตัวอย่างสถานการณ์ที่สามารถส่งประเมินในพื้นที่{localPage.area}</h2>
            <div class="case-study">
              <h3>กรณีมีสินค้าไอทีอยู่ในโซน{localPage.area}</h3>
              <p>ส่งรูป รุ่น สเปก สภาพ และพื้นที่โดยประมาณผ่าน LINE ได้ ทีมงานจะแจ้งราคาเบื้องต้นและความเป็นไปได้ในการจัดรอบนัดรับ โดยขึ้นอยู่กับคิวและระยะทาง</p>
              <p><strong>หมายเหตุ:</strong> ข้อความนี้เป็นตัวอย่างสถานการณ์ ไม่ใช่เคสลูกค้าจริง</p>
            </div>
            <h2>คำถามที่พบจากลูกค้าในพื้นที่{localPage.area}</h2>
            <div class="faq">
              {localPage.faq.map((f) => (
                <details class="faq__item">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
            <h2>ข้อมูลติดต่อ NAP ที่ต้องตรงกัน</h2>
            <table>
              <tbody>
                <tr><th>ชื่อธุรกิจ</th><td>{LOCAL_NAP.name}</td></tr>
                <tr><th>พื้นที่บริการ</th><td>{LOCAL_NAP.serviceArea}</td></tr>
                <tr><th>โทร</th><td>{LOCAL_NAP.phone}</td></tr>
                <tr><th>LINE</th><td>{LOCAL_NAP.line}</td></tr>
                <tr><th>เวลา</th><td>{LOCAL_NAP.hours}</td></tr>
              </tbody>
            </table>
          </>
        )}

        <DiscoveryHub
          id="discover"
          groups={discoveryGroups}
          title={localPage ? `สำรวจต่อจากพื้นที่${localPage.area}` : `สำรวจต่อจาก${detailItemLabel}`}
          intro={localPage
            ? 'ไปยังหน้าสินค้าที่รับในพื้นที่ ดูโซนใกล้เคียง และอ่านคู่มือเตรียมข้อมูลก่อนนัดรับ'
            : 'ย้อนกลับไปหน้าหมวด เปรียบเทียบรุ่นหรือแบรนด์ เช็กสภาพที่มีผลต่อราคา และดูพื้นที่นัดรับ โดยไม่ลิงก์ไปหน้าร่างที่ยังไม่พร้อมเผยแพร่'}
        />

        <div class="money-inline-cta"><strong>พร้อมเช็กราคาแล้ว?</strong><span>ส่งรูป รุ่น สภาพ และพื้นที่ผ่าน LINE ได้เลย ไม่ต้องกรอกแบบฟอร์ม</span><a href={SITE.lineHref} class="btn btn--line" data-track-event="click_line" data-cta-location="detail_mid_content">ส่งรูปประเมิน {SITE.lineId}</a></div>
        <h2 id="steps">ขั้นตอนส่งประเมินราคา</h2>
        <p>
          ถ่ายรูปตามรายการด้านบนแล้วส่งเข้า LINE {SITE.lineId}
          ทีมงานจะประเมินจากข้อมูลเฉพาะของรุ่น พื้นที่ และสภาพจริง ไม่ใช้ราคากลางแบบเปลี่ยนชื่อหน้าใน template เดียว
        </p>
      </div>
      <section class="section cta money-final-cta">
        <div class="container cta__in">
          <p class="eyebrow money-final-cta__eyebrow">ส่งข้อมูลก่อน · ตัดสินใจทีหลัง</p>
          <h2 class="cta__head">เช็กราคา{detailItemLabel}ผ่าน LINE ก่อนนัดรับ</h2>
          <p>ส่งรูป รุ่น สภาพ และพื้นที่ในขอนแก่น ทีมงานใช้ข้อมูลจริงของสินค้าประเมินเบื้องต้นให้ก่อน</p>
          <div class="cta__btns">
            <a href={SITE.lineHref} class="btn btn--line" data-track-event="click_line" data-cta-location="detail_final">ส่งรูปประเมินฟรี {SITE.lineId}</a>
            <a href={SITE.phoneHref} class="btn btn--volt" data-track-event="click_phone" data-cta-location="detail_final">โทร {SITE.phone}</a>
          </div>
        </div>
      </section>
    </main>
  )}
</Base>

<style>
  .cat-hero { padding-block: 48px; }
  .cat-hero h1 {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .lede, .article__body p, .article__body li {
    overflow-wrap: anywhere;
  }
  @media (max-width: 480px) {
    .cat-hero h1 {
      font-size: 1.6rem;
    }
    .lede {
      font-size: 0.95rem;
    }
  }
  .cat-hero__icon { font-size: 2.4rem; margin-bottom: 8px; }
  .cat-hero__product { max-width: 560px; margin: 20px 0 22px; border-radius: 16px; overflow: hidden; }
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 14px; max-width: 68ch; }
  .lede--soft { font-size: 0.98rem; color: var(--muted, #5b6577); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .crumb { font-size: 0.88rem; color: var(--ink-soft); margin-bottom: 18px; }
  .crumb a { color: var(--ink-soft); }
  .article__body { padding-block: 28px 56px; max-width: 760px; }
  .article__body h2 { margin-top: 36px; margin-bottom: 12px; }
  .article__body h3 { margin-top: 22px; margin-bottom: 8px; }
  .price-box { margin: 18px 0 22px; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; }
  .price-box__head { padding: 16px 18px; background: var(--mist); }
